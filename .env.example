# Release signing. Copy to `.env` (git ignores it) and fill in; only needed to set up
# signed releases with ./scripts/setup-signing.sh. Real values never go in this file.

# The certificate's full name, as shown by: security find-identity -v -p codesigning
SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# The Apple ID that owns the developer account, for notarization.
SIGN_APPLE_ID=you@example.com
# An app-specific password for that Apple ID (appleid.apple.com → Sign-In and Security).
SIGN_APP_PASSWORD=
